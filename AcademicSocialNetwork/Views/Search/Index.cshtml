@using AcademicSocialNetwork.Models
@using AcademicSocialNetwork.Helpers
@using System.Security.Claims
@model AcademicSocialNetwork.ViewModels.SearchResultsViewModel
@{
    ViewData["Title"] = "Search";
    var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
}

<div class="post-card mb-3 p-3">
    <h5 class="mb-0" style="color: var(--primary-color);">
        <i class="bi bi-search me-2"></i>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <span>Results for "<strong>@Model.Query</strong>"</span>
        }
        else
        {
            <span>Search</span>
        }
    </h5>
</div>

@if (string.IsNullOrEmpty(Model.Query))
{
    <div class="post-card text-center py-5">
        <i class="bi bi-search" style="font-size:3rem; color:var(--text-muted);"></i>
        <p class="text-muted mt-3">Type something in the search bar above.</p>
    </div>
}
else if (!Model.Users.Any() && !Model.Posts.Any())
{
    <div class="post-card text-center py-5">
        <i class="bi bi-emoji-frown" style="font-size:3rem; color:var(--text-muted);"></i>
        <p class="text-muted mt-3">No results found for "@Model.Query".</p>
    </div>
}
else
{
    @* ── People ── *@
    @if (Model.Users.Any())
    {
        <div class="post-card mb-3">
            <h6 class="mb-3" style="color: var(--primary-color);">
                <i class="bi bi-people me-1"></i> People
            </h6>
            @foreach (var user in Model.Users)
            {
                var majorEnum    = EnumExtensions.ParseOrNull<Major>(user.Major);
                var majorDisplay = majorEnum?.GetDisplayName() ?? user.Major ?? "Student";

                <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.Id"
                       class="flex-shrink-0">
                        @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                        {
                            <img src="@user.ProfileImageUrl" alt="@user.FullName"
                                 class="avatar-circle avatar-circle-medium"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar-circle avatar-circle-medium @AvatarHelper.GetAvatarColorClass(user.FullName)">
                                @AvatarHelper.GetInitials(user.FullName)
                            </div>
                        }
                    </a>
                    <div class="flex-grow-1">
                        <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.Id"
                           class="fw-semibold d-block" style="color: var(--primary-color);">
                            @user.FullName
                        </a>
                        <small class="text-muted">@majorDisplay @(user.ClassYear.HasValue ? $"· Class of {user.ClassYear}" : "")</small>
                    </div>
                    @if (user.Id != currentUserId)
                    {
                        <form asp-controller="Messages" asp-action="StartConversation" method="post" class="flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetUserId" value="@user.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-chat me-1"></i>Message
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }

    @* ── Posts ── *@
    @if (Model.Posts.Any())
    {
        <h6 class="mb-3 px-1" style="color: var(--primary-color);">
            <i class="bi bi-file-text me-1"></i> Posts
        </h6>
        @foreach (var post in Model.Posts)
        {
            var majorEnum    = EnumExtensions.ParseOrNull<Major>(post.Author?.Major);
            var majorDisplay = majorEnum?.GetDisplayName() ?? post.Author?.Major ?? "Unknown";

            <div class="post-card">
                <div class="post-header">
                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@post.Author?.Id">
                        @if (!string.IsNullOrEmpty(post.Author?.ProfileImageUrl))
                        {
                            <img src="@post.Author.ProfileImageUrl" alt="@post.Author.FullName"
                                 class="avatar-circle avatar-circle-medium" style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar-circle avatar-circle-medium @AvatarHelper.GetAvatarColorClass(post.Author?.FullName ?? "")">
                                @AvatarHelper.GetInitials(post.Author?.FullName ?? "?")
                            </div>
                        }
                    </a>
                    <div class="post-author flex-grow-1 ms-2">
                        <h6>
                            <a asp-controller="Profile" asp-action="Index" asp-route-id="@post.Author?.Id">
                                @(post.Author?.FullName ?? "Unknown User")
                            </a>
                        </h6>
                        <small>@majorDisplay • @post.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                </div>
                <div class="post-content">
                    <p>@post.Content</p>
                </div>
                <div class="post-actions">
                    <form asp-controller="Post" asp-action="Like" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@post.Id" />
                        <button type="submit" class="post-action border-0 bg-transparent">
                            <i class="bi @(post.Likes.Any(l => !l.IsDeleted && l.UserId == currentUserId) ? "bi-heart-fill" : "bi-heart")"></i>
                            <span>@post.LikeCount</span>
                        </button>
                    </form>
                </div>
            </div>
        }
    }
}