@model AcademicSocialNetwork.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<h4 class="auth-title">Welcome back</h4>
<p class="text-muted small mb-4">Sign in to your account to continue</p>

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
    {
        <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email address</label>
        <input asp-for="Email" class="form-control" placeholder="you@uni.bg" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-control" placeholder="••••••••" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4 d-flex align-items-center justify-content-between">
        <div class="form-check mb-0">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
            <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">Sign In</button>

    <p class="text-center small mb-0">
        Don't have an account?
        <a asp-action="Register" class="auth-link">Create one</a>
    </p>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}