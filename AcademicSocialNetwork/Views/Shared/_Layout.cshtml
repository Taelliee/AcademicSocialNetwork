@using AcademicSocialNetwork.Helpers
@using System.Security.Claims
@{
    var isAdmin         = User.IsInRole("Admin");
    var isAuthed        = User.Identity?.IsAuthenticated == true;
    var userName        = User.Identity?.Name ?? string.Empty;
    var profileImageUrl = User.FindFirst("ProfileImageUrl")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Academic Social Network</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AcademicSocialNetwork.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="top-nav">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-lg navbar-light">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill"></i> Academic Social Network
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (isAuthed)
                    {
                        <form class="d-flex mx-auto search-bar" asp-controller="Search" asp-action="Index" method="get">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input class="form-control" type="search" placeholder="Search students, posts, or topics..." name="q" />
                            </div>
                        </form>
                    }
                    <ul class="navbar-nav ms-auto">
                        @if (isAuthed)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door"></i>
                                </a>
                            </li>

                            @* Messages + Notifications badges — live counts from DB *@
                            @await Component.InvokeAsync("UnreadBadges")

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="profileDropdown"
                                   role="button" data-bs-toggle="dropdown">
                                    @if (!string.IsNullOrEmpty(profileImageUrl))
                                    {
                                        <img src="@profileImageUrl" alt="@userName"
                                             style="width:32px; height:32px; object-fit:cover; border-radius:50%;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-circle avatar-circle-small">
                                            @AvatarHelper.GetInitials(userName)
                                        </div>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-header small text-muted px-3 py-1">@userName</li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Edit"><i class="bi bi-gear"></i> Settings</a></li>
                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item text-warning" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-shield-fill"></i> Admin Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-sm btn-outline-light ms-2 px-3"
                                   asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    @if (ViewData["FullWidth"] is true)
    {
        <div class="main-wrapper">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="main-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <!-- Left Sidebar -->
                    <aside class="col-lg-3 col-md-4 d-none d-md-block left-sidebar">
                        <div class="sidebar-content">

                            @await Component.InvokeAsync("ProfileCard")

                            <div class="sidebar-menu">
                                <a asp-controller="Home" asp-action="Index" class="sidebar-link"><i class="bi bi-house-door"></i> Home Feed</a>
                                <a asp-controller="Profile" asp-action="Index" class="sidebar-link"><i class="bi bi-person"></i> My Profile</a>
                                <a asp-controller="Connections" asp-action="Index" class="sidebar-link"><i class="bi bi-people"></i> My Connections</a>
                                <a href="#" class="sidebar-link"><i class="bi bi-collection"></i> Study Groups</a>
                                <a href="#" class="sidebar-link"><i class="bi bi-calendar-event"></i> Campus Events</a>
                                <a href="#" class="sidebar-link"><i class="bi bi-book"></i> Resources</a>
                                @if (isAdmin)
                                {
                                    <a asp-controller="Admin" asp-action="Index" class="sidebar-link text-warning">
                                        <i class="bi bi-shield-fill"></i> Admin Dashboard
                                    </a>
                                }
                            </div>
                        </div>
                    </aside>

                    <!-- Main Content -->
                    <main class="col-lg-6 col-md-8 main-content">
                        @RenderBody()
                    </main>

                    <!-- Right Sidebar -->
                    <aside class="col-lg-3 d-none d-lg-block right-sidebar">
                        <div class="sidebar-content">
                            @await Component.InvokeAsync("SuggestedConnections")
                            @await Component.InvokeAsync("TrendingTopics")
                            @await Component.InvokeAsync("UpcomingEvents")
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    }

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-nav d-md-none">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item"><i class="bi bi-house-door"></i><small>Home</small></a>
        <a asp-controller="Search" asp-action="Index" class="mobile-nav-item"><i class="bi bi-search"></i><small>Search</small></a>
        <a asp-controller="Messages" asp-action="Index" class="mobile-nav-item"><i class="bi bi-chat-dots"></i><small>Messages</small></a>
        <a asp-controller="Profile" asp-action="Index" class="mobile-nav-item"><i class="bi bi-person"></i><small>Profile</small></a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
