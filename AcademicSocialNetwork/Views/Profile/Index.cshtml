@using AcademicSocialNetwork.Models
@using AcademicSocialNetwork.Helpers
@using System.Security.Claims
@model AcademicSocialNetwork.Models.User
@{
    ViewData["Title"] = "Profile";
    var isAdmin       = User.IsInRole("Admin");

    var followers = Model?.Followers?
        .Where(c => c.Status == ConnectionStatus.Accepted)
        .Select(c => c.Follower)
        .ToList() ?? new List<User>();

    var following = Model?.Following?
        .Where(c => c.Status == ConnectionStatus.Accepted)
        .Select(c => c.Following)
        .ToList() ?? new List<User>();

    var allConnections = followers.Union(following).ToList();

    // Resolve major display name once for the profile owner
    var majorEnum    = EnumExtensions.ParseOrNull<Major>(Model?.Major);
    var majorDisplay = majorEnum?.GetDisplayName() ?? Model?.Major ?? "";
}

<!-- Profile Header -->
<div class="post-card mb-4 p-0 overflow-hidden">

    <div class="profile-cover"></div>

    <div class="profile-info text-center px-3 pb-3">
        <div class="profile-avatar-wrapper">
            @if (!string.IsNullOrEmpty(Model?.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="@Model.FullName"
                     style="width:120px; height:120px; object-fit:cover; border-radius:50%;
                            border:4px solid var(--secondary-color);" />
            }
            else
            {
                <div class="avatar-circle avatar-circle-xlarge">
                    @AvatarHelper.GetInitials(Model?.FullName ?? "User Name")
                </div>
            }
        </div>

        <h3 class="mt-2 mb-1">@(Model?.FullName ?? "User Name")</h3>
        <p class="text-muted mb-0">@(majorDisplay != "" ? majorDisplay : "—")</p>
        <p class="text-muted small mb-3">
            @(Model?.ClassYear.HasValue == true ? $"Class of {Model.ClassYear}" : "")
        </p>

        <div class="d-flex justify-content-center gap-4 mb-3">
            <div class="text-center">
                <strong class="d-block">@followers.Count</strong>
                <small class="text-muted">Followers</small>
            </div>
            <div class="text-center">
                <strong class="d-block">@(Model?.Posts?.Count ?? 0)</strong>
                <small class="text-muted">Posts</small>
            </div>
            <div class="text-center">
                <strong class="d-block">@following.Count</strong>
                <small class="text-muted">Following</small>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            @if ((bool?)ViewBag.IsOwnProfile == true)
            {
                <a asp-action="Edit" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit Profile
                </a>
            }
            <button class="btn btn-outline-secondary">
                <i class="bi bi-share"></i> Share
            </button>
        </div>
    </div>
</div>

<!-- Profile Tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#posts">
            Posts <span class="badge ms-1">@(Model?.Posts?.Count ?? 0)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#about">About</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#connections">
            Connections <span class="badge ms-1">@allConnections.Count</span>
        </a>
    </li>
</ul>

<div class="tab-content">

    <!-- Posts -->
    <div class="tab-pane fade show active" id="posts">
        @if (Model?.Posts != null && Model.Posts.Any())
        {
            @foreach (var post in Model.Posts.OrderByDescending(p => p.CreatedAt))
            {
                <div class="post-card">
                    <div class="post-header">
                        @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                        {
                            <img src="@Model.ProfileImageUrl" alt="@Model.FullName"
                                 class="avatar-circle avatar-circle-medium"
                                 style="object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar-circle avatar-circle-medium @AvatarHelper.GetAvatarColorClass(Model.FullName)">
                                @AvatarHelper.GetInitials(Model.FullName)
                            </div>
                        }
                        <div class="post-author flex-grow-1 ms-2">
                            <h6>@Model.FullName</h6>
                            <small class="text-muted">@post.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                        </div>
                        @if ((bool?)ViewBag.IsOwnProfile == true || isAdmin)
                        {
                            <div class="dropdown">
                                <button class="btn btn-link text-muted" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Post" asp-action="Delete" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="post-content">
                        <p>@post.Content</p>
                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <div class="post-image-container mt-2">
                                <img src="@post.ImageUrl" alt="Post image" class="post-image" />
                            </div>
                        }
                    </div>
                    <div class="post-actions">
                        <div class="post-action">
                            <i class="bi bi-heart"></i>
                            <span>@post.LikeCount</span>
                        </div>
                        <div class="post-action">
                            <i class="bi bi-chat"></i>
                            <span>@(post.Comments?.Count ?? 0)</span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="post-card text-center py-5">
                <i class="bi bi-journal-text" style="font-size:3rem; color:var(--text-muted);"></i>
                <p class="text-muted mt-3">No posts yet</p>
            </div>
        }
    </div>

    <!-- About -->
    <div class="tab-pane fade" id="about">
        <div class="post-card">
            <h5 style="color: var(--primary-color);">About</h5>
            <hr>
            <p>
                <i class="bi bi-book me-2" style="color: var(--secondary-color);"></i>
                <strong>Major:</strong> @(majorDisplay != "" ? majorDisplay : "Not specified")
            </p>
            <p>
                <i class="bi bi-mortarboard me-2" style="color: var(--secondary-color);"></i>
                <strong>Class:</strong>
                @(Model?.ClassYear.HasValue == true ? $"Class of {Model.ClassYear}" : "Not specified")
            </p>
            @if (!string.IsNullOrEmpty(Model?.Bio))
            {
                <p>
                    <i class="bi bi-person-lines-fill me-2" style="color: var(--secondary-color);"></i>
                    <strong>Bio:</strong> @Model.Bio
                </p>
            }
            <p>
                <i class="bi bi-calendar me-2" style="color: var(--secondary-color);"></i>
                <strong>Joined:</strong> @(Model?.CreatedAt.ToString("MMMM yyyy") ?? "Unknown")
            </p>
        </div>
    </div>

    <!-- Connections -->
    <div class="tab-pane fade" id="connections">
        @if (allConnections.Any())
        {
            <div class="row">
                @foreach (var user in allConnections)
                {
                    var connMajorEnum    = EnumExtensions.ParseOrNull<Major>(user.Major);
                    var connMajorDisplay = connMajorEnum?.GetDisplayName() ?? user.Major ?? "—";
                    var connMajorAbbr    = connMajorEnum?.GetAbbreviation() ?? connMajorDisplay;

                    <div class="col-md-6 mb-3">
                        <div class="post-card d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                            {
                                <img src="@user.ProfileImageUrl" alt="@user.FullName"
                                     class="avatar-circle avatar-circle-connection flex-shrink-0"
                                     style="object-fit:cover;" />
                            }
                            else
                            {
                                <div class="avatar-circle avatar-circle-connection flex-shrink-0">
                                    @AvatarHelper.GetInitials(user.FullName)
                                </div>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.Id"
                                   class="fw-semibold d-block text-truncate"
                                   style="color: var(--primary-color);">
                                    @user.FullName
                                </a>
                                <small class="d-block text-muted" title="@connMajorDisplay">
                                    @connMajorAbbr
                                </small>
                                @if (user.ClassYear.HasValue)
                                {
                                    <small class="text-muted">Class of @user.ClassYear</small>
                                }
                            </div>
                            <a asp-controller="Messages" asp-action="Index"
                               class="btn btn-outline-secondary btn-sm flex-shrink-0">
                                <i class="bi bi-chat"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="post-card text-center py-5">
                <i class="bi bi-people" style="font-size:3rem; color:var(--text-muted);"></i>
                <p class="text-muted mt-3">No connections yet</p>
                <a asp-controller="Connections" asp-action="Discover" class="btn btn-primary">
                    Find Connections
                </a>
            </div>
        }
    </div>
</div>